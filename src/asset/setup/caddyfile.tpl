# Caddyfile — Generated by Razy Framework
# Do not edit manually; regenerate with: php Razy.phar rewrite --caddy

{
	frankenphp
	order php_server before file_server
}

<!-- START BLOCK: site -->
{$domain} {
	root * {$document_root}

<!-- START BLOCK: webassets -->
	# Webassets: {$mapping} — /webassets/{alias}/{version}/{file} is {container}/{version}/webassets/{file}
	@webasset_{$mapping_id} path /{$route_path}webassets/{$mapping}/*
	handle @webasset_{$mapping_id} {
		uri path_regexp ^/{$route_path}webassets/{$mapping}/([^/]+)/ /$1/webassets/
		root * {$container_path}
		file_server
	}
<!-- END BLOCK: webassets -->
<!-- START BLOCK: data_mapping -->
	# Data mapping: {$dist_code}
	# RZ-25: file_server sends bytes and does not run PHP. The prefix
	# matcher keeps /data/note.php/extra inside this handle, so it never
	# reaches the php handle. The rewrite drops a PATH_INFO tail after a
	# script extension; a missing file is 404. html, htm, svg, xml, xhtml,
	# js and mjs download and stay sandboxed. The active matcher sees the
	# extension on the original path and after strip_prefix.
	@data_{$data_id} path /{$route_path}data/*
	handle @data_{$data_id} {
		uri strip_prefix /{$route_path}data
		uri path_regexp `(?i)^(/.*?\.(?:php|phtml|phar))(?:/.*)$` `$1`
		root * {$data_path}
		@data_active_{$data_id} path_regexp `(?i)\.(?:html|htm|svg|xml|xhtml|js|mjs)$`
		header @data_active_{$data_id} {
			Content-Disposition "attachment"
			Content-Security-Policy "sandbox"
			X-Content-Type-Options "nosniff"
		}
		file_server
	}
<!-- END BLOCK: data_mapping -->
<!-- START BLOCK: shared -->
	# Shared modules
	@shared path /*/shared/*
	handle @shared {
		root * {$document_root}
		uri replace /shared/ /shared/ 1
		file_server
	}
<!-- END BLOCK: shared -->
<!-- START BLOCK: exclusion -->
	# Declared sibling paths (sites.inc.php 'exclude_paths') — never claimed by Razy.
	# The front-controller handle is gated on @not_excluded, so these paths are
	# served statically if present or 404; proxying them belongs to the edge
	# config (this file stays do-not-claim).
	@not_excluded not path {$path_patterns}
<!-- END BLOCK: exclusion -->
<!-- START BLOCK: php_claim -->
	# Claim scoping (coexistence Phase 2, Caddy side of Apache's per-mount
	# route_path discipline): the PHP claim covers ONLY the mounted prefixes
	# below; declared sibling exclusions stay outside it inside this matcher.
	{$matcher_body}
<!-- END BLOCK: php_claim -->
<!-- START BLOCK: health -->
	# Health probe (FM-5): on sub-path mounts the scoped claim would strand
	# /_razy/health, so it gets its own handle FIRST (pattern follows
	# deploy/Caddyfile — answer to Q5). Same front controller as the claim,
	# no worker: probes are answered pre-dispatch. REQUEST_URI stays the
	# original path (FrankenPHP 1.13 WithOriginalRequest).
	handle /_razy/health {
		header * {
			Cache-Control "no-store, max-age=0"
		}
		route {
			rewrite * /index.php
			php
		}
	}
<!-- END BLOCK: health -->
<!-- START BLOCK: worker -->
	# RZ-24: only index.php runs. php_server's try_files {path} would publish
	# this tree and execute every other .php. FrankenPHP 1.13 keeps REQUEST_URI
	# from the original request, so the rewrite does not change routing.
	handle{$php_matcher} {
		route {
			rewrite * /index.php
			php {
				worker {$document_root}/index.php
			}
		}
	}
<!-- END BLOCK: worker -->
<!-- START BLOCK: standard -->
	# RZ-24: classic mode, same front-controller claim, no worker.
	handle{$php_matcher} {
		route {
			rewrite * /index.php
			php
		}
	}
<!-- END BLOCK: standard -->
}

<!-- END BLOCK: site -->
