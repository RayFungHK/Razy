# Razy Benchmark — PHP-FPM Baseline (plain fpm, NO worker)
#
# The audit's both-sides-FPM recommendation (COMPETITOR-LANDSCAPE.md §5): the
# 2026-02 table only knew FrankenPHP-vs-Swoole. This image runs the SAME site
# (same config.inc.php, same standalone module incl. template/DB endpoints) on
# stock php-fpm: every request pays full boot — the honest baseline for what
# worker mode buys either framework.

FROM php:8.3-fpm-alpine

RUN docker-php-ext-install pdo_mysql opcache pcntl

# Byte-identical OPcache policy to the worker images (symmetry law)
RUN { echo "opcache.enable=1"; \
      echo "opcache.enable_cli=1"; \
      echo "opcache.memory_consumption=256"; \
      echo "opcache.interned_strings_buffer=32"; \
      echo "opcache.max_accelerated_files=10000"; \
      echo "opcache.validate_timestamps=0"; \
      echo "opcache.jit_buffer_size=128M"; \
      echo "opcache.jit=1255"; \
      echo "realpath_cache_size=4096K"; \
      echo "realpath_cache_ttl=600"; \
      echo "memory_limit=256M"; \
    } > /usr/local/etc/php/conf.d/benchmark.ini

WORKDIR /app

COPY Razy.phar /app/Razy.phar
COPY vendor /app/vendor
COPY composer.json /app/composer.json

RUN mkdir -p /app/site/data/cache /app/site/plugins

COPY benchmark/razy/config.inc.php /app/site/config.inc.php
COPY benchmark/razy/standalone /app/site/standalone

# Same front controller as the worker image (chdir pins SYSTEM_ROOT to /app/site)
RUN printf '<?php\nnamespace Razy;\nuse Exception;\nuse Phar;\n\nchdir(__DIR__);\n$razyConfig = require __DIR__ . "/config.inc.php";\n$pharPath = ($razyConfig["phar_location"] ?? __DIR__) . "/Razy.phar";\nPhar::loadPhar($pharPath, "Razy.phar");\ninclude "phar://Razy.phar/main.php";\n' > /app/site/index.php

# fpm pool: one worker process per request-slot, pm static for determinism
RUN { echo "[www]"; \
      echo "user = www-data"; \
      echo "group = www-data"; \
      echo "listen = 9000"; \
      echo "pm = static"; \
      echo "pm.max_children = 32"; \
      echo "pm.status_path = /fpm-status"; \
      echo "clear_env = no"; \
    } > /usr/local/etc/php-fpm.d/zz-benchmark.conf \
    && sed -i '/^listen.acl/d' /usr/local/etc/php-fpm.d/www.conf 2>/dev/null || true

# Toolchain receipt (mirror of worker images)
RUN { echo "php=$(php -r 'echo PHP_VERSION;')"; \
      echo "runtime=php-fpm (no worker)"; \
      echo "razy_phar_sha256=$(sha256sum /app/Razy.phar | cut -d' ' -f1)"; \
    } > /toolchain.txt && cat /toolchain.txt

EXPOSE 9000
