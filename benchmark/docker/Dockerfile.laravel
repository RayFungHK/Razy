# Laravel + Octane (FRANKENPHP driver) Benchmark Image
#
# 2026-09 re-run (COMPETITOR-LANDSCAPE.md §5): the 2026-02 suite measured
# FrankenPHP-worker Razy vs Swoole-coroutine Laravel — the audit correctly called
# that a runtime-vs-runtime comparison, not a framework one. This image puts BOTH
# sides on the identical FrankenPHP runtime (Octane's frankenphp driver), which is
# also Laravel's own production-recommended worker today.
#
# Toolchain PINNED per the audit's pinned-toolchain rule. Bump all together — one
# bump = one new measurement epoch, old results belong to the old epoch:
#   FrankenPHP 1.10 / PHP 8.3 / Laravel ^13 / Octane ^2

FROM dunglas/frankenphp:1.10-php8.3-alpine

RUN install-php-extensions \
    pdo_mysql \
    opcache \
    pcntl \
    zip \
    intl \
    bcmath

# Byte-identical OPcache policy to the Razy side (symmetry law)
RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/benchmark.ini && \
    echo "opcache.enable_cli=1" >> /usr/local/etc/php/conf.d/benchmark.ini && \
    echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/benchmark.ini && \
    echo "opcache.interned_strings_buffer=32" >> /usr/local/etc/php/conf.d/benchmark.ini && \
    echo "opcache.max_accelerated_files=10000" >> /usr/local/etc/php/conf.d/benchmark.ini && \
    echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/benchmark.ini && \
    echo "opcache.jit_buffer_size=128M" >> /usr/local/etc/php/conf.d/benchmark.ini && \
    echo "opcache.jit=1255" >> /usr/local/etc/php/conf.d/benchmark.ini && \
    echo "realpath_cache_size=4096K" >> /usr/local/etc/php/conf.d/benchmark.ini && \
    echo "realpath_cache_ttl=600" >> /usr/local/etc/php/conf.d/benchmark.ini && \
    echo "memory_limit=256M" >> /usr/local/etc/php/conf.d/benchmark.ini

COPY --from=composer:2.9 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Fresh Laravel, pinned major (the old image floated to whatever main was).
# The frankenphp base ships a non-empty /app — create-project into a staging
# dir, then transplant.
RUN composer create-project laravel/laravel:^13.0 /tmp/lf --prefer-dist --no-interaction --no-dev \
    --no-scripts && cp -a /tmp/lf/. /app/ && rm -rf /tmp/lf

# --no-scripts skips Laravel's create-env hook — materialize .env by hand
RUN cp -n /app/.env.example /app/.env || true

RUN composer require laravel/octane:^2.0 --no-interaction \
    && php artisan octane:install --server=frankenphp --no-interaction || true

# Production env + the SAME shared benchmark MySQL the Razy side uses
RUN sed -i 's/APP_ENV=local/APP_ENV=production/' /app/.env \
    && sed -i 's/APP_DEBUG=true/APP_DEBUG=false/' /app/.env \
    && sed -i 's/^DB_CONNECTION=sqlite/DB_CONNECTION=mysql/' /app/.env \
    && sed -i 's/^# DB_HOST=127.0.0.1/DB_HOST=mysql/' /app/.env \
    && sed -i 's/^# DB_PORT=3306/DB_PORT=3306/' /app/.env \
    && sed -i 's/^# DB_DATABASE=laravel/DB_DATABASE=benchmark/' /app/.env \
    && sed -i 's/^# DB_USERNAME=root/DB_USERNAME=benchmark/' /app/.env \
    && sed -i 's/^# DB_PASSWORD=/DB_PASSWORD=benchmark/' /app/.env \
    && sed -i 's/^SESSION_DRIVER=database/SESSION_DRIVER=array/' /app/.env \
    && sed -i 's/^CACHE_STORE=database/CACHE_STORE=array/' /app/.env

# Benchmark routes and views (real Blade + real Eloquent — symmetry law)
COPY benchmark/laravel/routes/benchmark.php /app/routes/benchmark.php
COPY benchmark/laravel/views/benchmark /app/resources/views/benchmark

# Register the benchmark routes (printf, NOT echo: busybox ash leaves \n literal
# and the stray "\nrequire" was a PHP ParseError at __DIR__, caught live 2026-09)
RUN printf "\nrequire __DIR__.'/benchmark.php';\n" >> /app/routes/web.php

# POST /benchmark/db-write must skip CSRF (k6 carries no session) — same waiver as the old suite
RUN sed -i "s/->withMiddleware(function (Middleware \$middleware): void {/->withMiddleware(function (Middleware \$middleware): void {\n        \$middleware->validateCsrfTokens(except: ['benchmark\/*']);/" /app/bootstrap/app.php

# Cache everything after all changes are in place.
# key:generate first: --no-scripts above skipped create-project's own
# key:generate hook, and Octane's worker dies at boot (never reaching
# frankenphp_handle_request) with "No application encryption key".
RUN php artisan key:generate --force \
    && php artisan config:cache \
    && php artisan route:cache \
    && php artisan view:cache

# Record the resolved toolchain INTO the image — a run without this receipt is
# not a run (pinned-toolchain rule): docker exec bench-laravel cat /toolchain.txt
RUN { echo "laravel=$(composer show laravel/framework --no-interaction 2>/dev/null | awk '/^versions/{print $NF}')"; \
      echo "octane=$(composer show laravel/octane --no-interaction 2>/dev/null | awk '/^versions/{print $NF}')"; \
      echo "php=$(php -r 'echo PHP_VERSION;')"; \
      echo "frankenphp=$(frankenphp version 2>/dev/null | head -1 | tr -d '\r')"; \
    } > /toolchain.txt && cat /toolchain.txt

EXPOSE 8080

# Octane on the frankenphp driver — the same runtime family the Razy worker runs on
CMD ["php", "artisan", "octane:frankenphp", "--host=0.0.0.0", "--port=8080", "--workers=auto"]
