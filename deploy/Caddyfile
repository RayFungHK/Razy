# =============================================================================
# deploy/Caddyfile — FrankenPHP *worker mode* config for Razy (production)
# =============================================================================
# PURPOSE
#   Production Caddyfile for the worker image (deploy/Dockerfile.worker). It is
#   the benchmark config (benchmark/docker/Caddyfile.razy) hardened for real
#   traffic: same worker launch, plus JSON access logs, gzip/zstd, request
#   timeouts, trusted-proxy handling, and an explicit `/_razy/health` route so
#   Kubernetes probes never depend on the application router.
#
# 15000-TPS RELEVANCE
#   `frankenphp { worker ... }` is the single reason Razy reaches 4.5k-6.3k RPS
#   per 2 vCPU pod in benchmark/results — the PHP process survives across
#   requests (src/main.php:116-248 boots the Application once, then loops on
#   frankenphp_handle_request). Everything that is NOT the worker (file_server,
#   compression, logging) must stay cheap, which is why:
#     * num_threads is explicit (capacity per pod = num_threads × pods; the HPA
#       cannot help a pod whose queue is saturated — see deploy/k8s/README.md),
#     * max_queue_size is finite so overload becomes a fast 503 instead of an
#       unbounded latency spiral that trips probes and restarts pods,
#     * /_razy/health is answered by the framework before routing
#       (src/library/Razy/Health.php:33-54) and is NOT compressed here, so probe
#       cost stays negligible even at thousands of probes/minute.
#
# WORKER ENTRY CONTRACT
#   The worker script boots Razy exactly like the benchmark image
#   (benchmark/docker/Dockerfile.razy:47): chdir to SYSTEM_ROOT, require
#   config.inc.php, Phar::loadPhar, include phar://Razy.phar/main.php.
#
# INDENTATION
#   Spaces, not tabs — so this exact text can be embedded byte-for-byte in
#   deploy/k8s/configmap.yaml (YAML block scalars dislike tab indentation).
#
# ENV PLACEHOLDERS (expanded by Caddy when it parses this file, so the same text
# works in the image and in the ConfigMap — deploy/k8s/configmap.yaml):
#   FRANKENPHP_NUM_THREADS      default 2   (the measured 2 vCPU anchor)
#   FRANKENPHP_MAX_QUEUE_SIZE   default 1024
#   FRANKENPHP_MAX_WAIT_TIME    default 30s
# =============================================================================

{
    # ---- Worker mode: the one block that matters -----------------------------
    # Persistent PHP worker; every request is dispatched into the bootstrapped
    # Razy process instead of re-executing PHP.
    frankenphp {
        worker /app/site/index.php {
            # PHP worker threads per container. The measured anchors were taken
            # on a 2 vCPU container, so 2 is the proven default: more threads
            # than cores only moves queueing into the CPU scheduler.
            num_threads {$FRANKENPHP_NUM_THREADS:2}

            # Bounded admission control. Requests beyond num_threads queue; once
            # the queue is full Caddy rejects immediately. Under a 15k-TPS ramp
            # this is what keeps p99 honest and stops readinessProbe from failing
            # because of queue latency alone.
            max_queue_size {$FRANKENPHP_MAX_QUEUE_SIZE:1024}

            # Time a queued request may wait for a free worker before 503.
            max_wait_time  {$FRANKENPHP_MAX_WAIT_TIME:30s}

            # Newer FrankenPHP builds can also cap worker RSS
            # (`max_constant_memory 1024M`). Left commented: enable only after
            # confirming your FrankenPHP version supports it, and keep it below
            # the container memory limit minus the OPcache shm pool
            # (deploy/php-opcache.ini).
            # max_constant_memory 1024M
        }
    }

    # Worker mode answers everything through PHP; keep php_server ahead of
    # file_server so no request ever waits on a stat() walk first.
    # (Same ordering as benchmark/docker/Caddyfile.razy:10.)
    order php_server before file_server

    # ---- Cluster reality: TLS is terminated at the Ingress --------------------
    # Caddy must not try ACME or force redirects on a plain-HTTP pod listener;
    # the public TLS policy lives in deploy/k8s/ingress.yaml.
    auto_https disable_redirects

    # Admin API off = no extra listener to defend and no accidental /metrics
    # port. To feed the HPA custom metric (deploy/k8s/hpa.yaml), switch to
    # `admin localhost:2019` and scrape /metrics from the pod instead.
    admin off

    # ---- Global (process/startup) log: structured, stderr, container-native ---
    log {
        output stderr
        format  json
        level   INFO
    }

    # ---- Listener behaviour --------------------------------------------------
    servers {
        # h1 for the Ingress, h2c for in-cluster callers that speak gRPC.
        protocols h1 h2c

        # X-Forwarded-For / X-Forwarded-Proto are trusted only from pod/network
        # ranges, so client IPs and Host-based routing cannot be spoofed from
        # outside the Ingress.
        trusted_proxies static private_ranges

        # Explicit timeouts: no slowloris-style worker pinning. A worker thread
        # blocked by a slow client is a thread stolen from the 15k-TPS budget.
        timeouts {
            read_body   15s
            read_header 10s
            write       60s
            idle        75s
        }
    }
}

# =============================================================================
# Pod listener (plain HTTP; deploy/k8s/service.yaml targets this port)
# =============================================================================
:8080 {
    root * /app/site

    # --- Framework liveness probe -------------------------------------------
    # Passthrough, kept first and explicit.
    #
    # Why a dedicated block:
    #   * /_razy/health is answered inside the worker before routing
    #     (src/library/Razy/Health.php:24,170) — the block keeps that path out of
    #     the catch-all handler so probe traffic cannot be affected by site
    #     rewrites or compression settings;
    #   * probes must never be served from a cache layer, hence no-store
    #     (Health.php:48 already sends it; Caddy asserts it at the edge too —
    #     note the app's own header() wins if they ever diverge);
    #   * because `encode` lives in the other handle block below, probe JSON is
    #     never compressed.
    handle /_razy/health {
        header * {
            Cache-Control "no-store, max-age=0"
        }
        php_server
    }

    # --- Everything else: the Razy worker -----------------------------------
    handle {
        header * {
            X-Content-Type-Options "nosniff"
            X-Frame-Options        "SAMEORIGIN"
            Referrer-Policy        "strict-origin-when-cross-origin"
        }

        # Response compression for real traffic: zstd first (content negotiation),
        # gzip for compatibility. Caddy's default min_length (1024 B) stays in
        # force, so tiny JSON responses do not burn compression CPU at 15k RPS.
        # Site responses only — see the probe block note above.
        encode zstd gzip

        # Baseline response hardening. Razy strips X-Powered-By itself
        # (src/system/bootstrap.inc.php:27) and expose_php=0
        # (deploy/php-opcache.ini); the block above covers the rest.
        php_server
    }

    # --- Access log: structured JSON on stderr ------------------------------
    # Collected by the container runtime. `level INFO` keeps one line per
    # response; at 15k RPS that is 15k lines/s, so raise to WARN if your log
    # pipeline (not Caddy) becomes the bottleneck.
    log {
        output stderr
        format  json
        level   INFO
    }
}

# =============================================================================
# OPTIONAL: TLS-terminating edge (only if this pod must serve 80/443 itself)
# =============================================================================
# Ports 80/443 need privilege the non-root image (USER 10001 in
# deploy/Dockerfile.worker) does not have. Either add NET_BIND_SERVICE to the pod
# or — preferably — leave TLS to the Ingress. If you do terminate TLS here:
#
# raz.example.com {
#     php_server
#     log {
#         output stderr
#         format  json
#         level   INFO
#     }
# }
