# Ignore everything by default
*

# === Tracked files ===
!.gitignore
!.php-cs-fixer.dist.php
!phpstan.neon
!phpstan.modules.neon
!phpstan-bootstrap.php
!LICENSE
!VERSION
!build.php
!composer.json
!readme.md
!phpunit.xml
!repository.inc.php
!Razy.phar

# Source
!src/
!src/**

# Demo modules (reference examples)
!demo_modules/
!demo_modules/**

# Tests
!tests/
!tests/**

# Documentation site
!documentation/
!documentation/**

# Wiki (pushed separately to GitHub wiki repo)
# !Razy.wiki/
# !Razy.wiki/**

# Changelog
!changelog/
!changelog/**

# GitHub CI & templates
!.github/
!.github/**

# Docker (image build, compose, Caddy config)
!.docker/
!.docker/**
!.dockerignore

# DevContainer (Codespaces / VS Code)
!.devcontainer/
!.devcontainer/**

# Community files
!CONTRIBUTING.md
!SECURITY.md
!CODE_OF_CONDUCT.md
!.editorconfig

# LLM navigation files
!LLM-CAS.md
!skills.md
!CLASS-CATALOG.md

# Architecture & design docs
!architecture/
!architecture/**

# Git hooks (pre-commit quality gates)
!.githooks/
!.githooks/**

# Benchmark suite (reproducible performance tests)
!benchmark/
!benchmark/**

# === Documentation v2 (2026-07 redesign) + first-party modules ===
!AGENTS.md!RAZY-ANALYSIS-REPORT.md
!manual/
!manual/**
!skills/
!modules/
!modules/**
!skills/**
!demos/
!demos/**
!site/
!site/**
!tools/
!tools/**
!deploy/
!deploy/**

# === First-party package tree (tests/DashboardPackageTest reads it; a CI
# checkout without it can never pass) ===
!packages/
!packages/**
# ...except the publish credentials — its own header says DO NOT commit
packages/publish.inc.php

# === Lock file: CI must install THE verified dependency set, not re-resolve
# (2026-09 CI reddening: unpinned phpstan/cs-fixer patches changed rules on
# untouched code) ===
!composer.lock

# k6 timestamped byproducts (canonical records are results/<target>/*_runN.json)
benchmark/results/*_20*T*Z.json

# local compiled-boot artifacts (bench hosts) - baked per-image at build, never committed
benchmark/razy/data/
benchmark/gate/site/data/

benchmark/scale/site/data/
benchmark/scale/site/sites/scaletest/
